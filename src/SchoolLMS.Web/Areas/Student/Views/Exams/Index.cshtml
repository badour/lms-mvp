@model IReadOnlyList<SchoolLMS.Application.DTOs.Exams.StudentExamItemDto>
@{
    ViewData["Title"] = "الامتحانات";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">بوابة الطالب</div>
    <h1 class="h3 page-title mb-1">الامتحانات</h1>
    <p class="text-muted mb-0">امتحانات صفك في مدرستك ومرحلتك</p>
</div>

<section class="section-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
            <tr>
                <th>التاريخ</th>
                <th>الفترة</th>
                <th>الدرس</th>
                <th>المعلم</th>
                <th>المرحلة</th>
                <th>الصف</th>
                <th>ملاحظات</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد امتحانات منشورة لصفك حالياً.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ExamDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.TimeSlot</td>
                    <td>@item.LessonNameAr</td>
                    <td>@item.TeacherNameAr</td>
                    <td>@item.StageNameAr</td>
                    <td>@item.ClassNameAr</td>
                    <td>
                        @(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)
                        @if (!string.IsNullOrWhiteSpace(item.Instructions))
                        {
                            <div class="small text-muted mt-1">@item.Instructions</div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
