@model SchoolLMS.Application.DTOs.Dashboards.StudentDashboardDto?
@if (Model is null)
{
    <div class="alert alert-info">لا توجد بيانات طالب مرتبطة.</div>
}
else
{
    <h1 class="h3 page-title mb-1">مرحباً @Model.StudentNameAr</h1>
    <p class="text-muted">@Model.SchoolNameAr · @Model.GradeNameAr / @Model.SectionNameAr · @Model.StudentNumber</p>
    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card stat-card p-3"><div class="stat-label">نسبة الحضور</div><div class="stat-value">@Model.AttendancePercent%</div></div></div>
        <div class="col-md-3"><div class="card stat-card p-3"><div class="stat-label">واجبات معلقة</div><div class="stat-value">@Model.PendingHomework</div></div></div>
        <div class="col-md-3"><div class="card stat-card p-3"><div class="stat-label">واجبات مسلّمة</div><div class="stat-value">@Model.SubmittedHomework</div></div></div>
        <div class="col-md-3"><div class="card stat-card p-3"><div class="stat-label">غياب</div><div class="stat-value">@Model.DaysAbsent</div></div></div>
    </div>
    <div class="row g-3">
        <div class="col-md-6"><div class="card stat-card p-3"><h5>الإعلانات</h5>@foreach (var a in Model.Announcements){<div class="py-2 border-bottom">@a.TitleAr</div>}</div></div>
        <div class="col-md-6"><div class="card stat-card p-3"><h5>الامتحانات القادمة</h5>@foreach (var e in Model.UpcomingExams){<div class="py-2 border-bottom">@e.Title · @e.Subtitle</div>}</div></div>
    </div>
}
