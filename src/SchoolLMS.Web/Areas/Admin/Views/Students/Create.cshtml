@model SchoolLMS.Application.DTOs.Students.CreateStudentRequest
<h1 class="h3 page-title mb-3">إضافة طالب</h1>
<form method="post" class="card stat-card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label">المدرسة</label><select asp-for="SchoolId" class="form-select" asp-items="ViewBag.Schools"></select></div>
        <div class="col-md-4"><label class="form-label">رقم الطالب</label><input asp-for="StudentNumber" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">الجنس</label><select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<SchoolLMS.Domain.Enums.Gender>()"></select></div>
        <div class="col-md-6"><label class="form-label">الاسم بالعربية</label><input asp-for="FullNameAr" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">الاسم بالإنجليزية</label><input asp-for="FullNameEn" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">السنة الدراسية</label><select asp-for="AcademicYearId" class="form-select" asp-items="ViewBag.Years"><option value="">-</option></select></div>
        <div class="col-md-4"><label class="form-label">الصف</label><select asp-for="GradeLevelId" class="form-select" asp-items="ViewBag.Grades"><option value="">-</option></select></div>
        <div class="col-md-4"><label class="form-label">الشعبة</label><select asp-for="ClassSectionId" class="form-select" asp-items="ViewBag.Sections"><option value="">-</option></select></div>
        <div class="col-md-4"><label class="form-label">الجنسية</label><input asp-for="Nationality" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">تاريخ الميلاد</label><input asp-for="DateOfBirth" class="form-control" type="date" /></div>
        <div class="col-md-4"><label class="form-label">الهوية</label><input asp-for="NationalId" class="form-control" /></div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" type="submit">حفظ</button>
        <a class="btn btn-outline-secondary" asp-action="Index">رجوع</a>
    </div>
</form>
