@model SchoolLMS.Application.Common.PagedResult<SchoolLMS.Application.DTOs.Students.StudentListItemDto>
<div class="d-flex justify-content-between mb-3">
    <h1 class="h3 page-title">الطلاب</h1>
    <a class="btn btn-primary" asp-action="Create">إضافة طالب</a>
</div>
<form method="get" class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">بحث</label><input name="Search" value="@Context.Request.Query["Search"]" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">المدرسة</label><select name="SchoolId" class="form-select" asp-items="ViewBag.Schools"><option value="">الكل</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">تصفية</button></div>
    </div>
</form>
<div class="card stat-card p-3">
<table class="table table-hover">
<thead><tr><th>الرقم</th><th>الاسم</th><th>المدرسة</th><th>الصف</th><th>الشعبة</th><th>الحالة</th></tr></thead>
<tbody>
@foreach (var item in Model.Items)
{
    <tr>
        <td>@item.StudentNumber</td>
        <td>@item.FullNameAr</td>
        <td>@item.SchoolNameAr</td>
        <td>@item.GradeNameAr</td>
        <td>@item.SectionNameAr</td>
        <td>@item.Status</td>
    </tr>
}
</tbody>
</table>
<div class="small text-muted">صفحة @Model.Page من @Model.TotalPages · الإجمالي @Model.TotalCount</div>
</div>
