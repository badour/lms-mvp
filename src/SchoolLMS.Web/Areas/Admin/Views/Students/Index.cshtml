@model SchoolLMS.Application.Common.PagedResult<SchoolLMS.Application.DTOs.Students.StudentListItemDto>
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 page-title mb-1">الطلاب</h1>
        <p class="text-muted mb-0">إدارة تسجيل الطلاب وبياناتهم</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> إضافة طالب جديد</a>
</div>
<form method="get" class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label">بحث</label><input name="Search" value="@Context.Request.Query["Search"]" class="form-control" placeholder="الاسم / رقم الطالب" /></div>
        <div class="col-md-3"><label class="form-label">المدرسة</label><select name="SchoolId" class="form-select" asp-items="ViewBag.Schools"><option value="">الكل</option></select></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">تصفية</button></div>
    </div>
</form>
<div class="card stat-card p-3">
<table class="table table-hover align-middle">
<thead>
<tr>
    <th>الرقم</th>
    <th>اسم الطالب</th>
    <th>اسم الأب</th>
    <th>الهاتف</th>
    <th>المدرسة</th>
    <th>الصف</th>
    <th>الشعبة</th>
    <th>الحالة</th>
    <th></th>
</tr>
</thead>
<tbody>
@foreach (var item in Model.Items)
{
    <tr>
        <td>@item.StudentNumber</td>
        <td>@item.FullNameAr</td>
        <td>@item.FatherName</td>
        <td>@item.Phone1</td>
        <td>@item.SchoolNameAr</td>
        <td>@item.GradeNameAr</td>
        <td>@item.SectionNameAr</td>
        <td>@item.Status</td>
        <td>
            <div class="d-flex gap-1 flex-wrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id" title="عرض"><i class="bi bi-eye"></i></a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id" title="تعديل"><i class="bi bi-pencil"></i></a>
                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا الطالب؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        </td>
    </tr>
}
@if (!Model.Items.Any())
{
    <tr><td colspan="9" class="text-center text-muted py-4">لا يوجد طلاب.</td></tr>
}
</tbody>
</table>
<div class="small text-muted">صفحة @Model.Page من @Model.TotalPages · الإجمالي @Model.TotalCount</div>
</div>
