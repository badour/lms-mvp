@model SchoolLMS.Application.DTOs.Schools.CreateSchoolRequest
<h1 class="h3 page-title mb-3">إضافة مدرسة</h1>
<form method="post" class="card stat-card p-4 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">الاسم بالعربية</label><input asp-for="NameAr" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">الاسم بالإنجليزية</label><input asp-for="NameEn" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">الهاتف</label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">البريد</label><input asp-for="Email" class="form-control" /></div>
        <div class="col-12"><label class="form-label">العنوان</label><input asp-for="Address" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">النوع</label><input asp-for="SchoolType" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">الجنس</label><input asp-for="GenderType" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">العملة</label><input asp-for="Currency" class="form-control" /></div>
    </div>
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" type="submit">حفظ</button>
        <a class="btn btn-outline-secondary" asp-action="Index">رجوع</a>
    </div>
</form>
