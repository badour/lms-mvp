@model SchoolLMS.Application.Common.PagedResult<SchoolLMS.Application.DTOs.Teachers.TeacherListItemDto>
@{
    ViewData["Title"] = "المعلمون";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">وضع المعلم</div>
        <h1 class="h3 page-title mb-1">المعلمون</h1>
        <p class="text-muted mb-0">عرض وتعديل وحذف حسابات المعلمين</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> إضافة معلم</a>
</div>

<form method="get" class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">بحث</label>
            <input name="Search" value="@Context.Request.Query["Search"]" class="form-control" placeholder="الاسم / الوثيقة / الهاتف" />
        </div>
        <div class="col-md-3">
            <label class="form-label">المدرسة</label>
            <select name="SchoolId" class="form-select" asp-items="ViewBag.Schools">
                <option value="">الكل</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">تصفية</button>
        </div>
    </div>
</form>

<div class="card stat-card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>اسم المعلم</th>
                <th>رقم الوثيقة</th>
                <th>الهاتف</th>
                <th>المدرسة</th>
                <th>الدور</th>
                <th>التخصص</th>
                <th>الشعب</th>
                <th>الدروس</th>
                <th>الحالة</th>
                <th style="width:140px">إجراءات</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-4">لا يوجد معلمون بعد.</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="fw-semibold">@item.FullNameAr</td>
                    <td>@(item.DocumentId ?? "—")</td>
                    <td>@(item.Phone ?? "—")</td>
                    <td>@item.SchoolNameAr</td>
                    <td>@item.RoleName</td>
                    <td>@(item.Specialization ?? "—")</td>
                    <td>@item.ClassCount</td>
                    <td>@item.LessonCount</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="pill pill-green">نشط</span>
                        }
                        else
                        {
                            <span class="pill pill-orange">غير نشط</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1 flex-wrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id" title="عرض"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id" title="تعديل"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('حذف هذا المعلم؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="small text-muted">صفحة @Model.Page من @Model.TotalPages · الإجمالي @Model.TotalCount</div>
</div>
