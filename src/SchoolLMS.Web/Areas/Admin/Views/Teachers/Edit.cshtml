@model SchoolLMS.Web.Models.TeacherForm
@{
    ViewData["Title"] = "تعديل المعلم";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">وضع المعلم</div>
    <h1 class="h3 page-title mb-1">تعديل المعلم</h1>
    <p class="text-muted mb-0">@Model.FullNameAr</p>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_TeacherForm" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ التعديلات</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">رجوع</a>
    </div>
</form>
