@model SchoolLMS.Application.DTOs.Teachers.TeacherDetailsDto
@{
    ViewData["Title"] = "عرض المعلم";
    string GenderText(SchoolLMS.Domain.Enums.Gender g) => g == SchoolLMS.Domain.Enums.Gender.Female ? "أنثى" : "ذكر";
    string MaritalText(SchoolLMS.Domain.Enums.MaritalStatus s) => s switch
    {
        SchoolLMS.Domain.Enums.MaritalStatus.Married => "متزوج",
        SchoolLMS.Domain.Enums.MaritalStatus.Divorced => "مطلق",
        SchoolLMS.Domain.Enums.MaritalStatus.Widowed => "أرمل",
        _ => "أعزب"
    };
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">وضع المعلم</div>
        <h1 class="h3 page-title mb-1">@Model.FullNameAr</h1>
        <p class="text-muted mb-0">@Model.SchoolNameAr · @Model.RoleName</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> تعديل</a>
        <a class="btn btn-outline-secondary" asp-action="Index">رجوع</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <section class="section-card mb-3">
            <h2>البيانات الأساسية</h2>
            <div class="row g-3">
                <div class="col-md-6"><div class="small text-muted">رقم الوثيقة</div><div class="fw-semibold">@(Model.DocumentId ?? "—")</div></div>
                <div class="col-md-6"><div class="small text-muted">الهاتف</div><div class="fw-semibold">@(Model.Phone ?? "—")</div></div>
                <div class="col-md-6"><div class="small text-muted">اسم الأب</div><div class="fw-semibold">@(Model.ParentName ?? "—")</div></div>
                <div class="col-md-6"><div class="small text-muted">اسم الأم</div><div class="fw-semibold">@(Model.MotherName ?? "—")</div></div>
                <div class="col-md-4"><div class="small text-muted">الجنس</div><div class="fw-semibold">@GenderText(Model.Gender)</div></div>
                <div class="col-md-4"><div class="small text-muted">الحالة الاجتماعية</div><div class="fw-semibold">@MaritalText(Model.MaritalStatus)</div></div>
                <div class="col-md-4"><div class="small text-muted">المدينة</div><div class="fw-semibold">@(Model.City ?? "—")</div></div>
                <div class="col-12"><div class="small text-muted">العنوان</div><div class="fw-semibold">@(Model.Address ?? "—")</div></div>
                <div class="col-md-6"><div class="small text-muted">تاريخ المباشرة</div><div class="fw-semibold">@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                <div class="col-md-6"><div class="small text-muted">تاريخ الانتهاء</div><div class="fw-semibold">@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "—")</div></div>
                <div class="col-12"><div class="small text-muted">المعلومات التعليمية</div><p class="mb-0 inbox-body">@(string.IsNullOrWhiteSpace(Model.EducationalInfo) ? "—" : Model.EducationalInfo)</p></div>
            </div>
        </section>

        <section class="section-card mb-3">
            <h2>الشعب المرتبطة</h2>
            @if (!Model.Classes.Any())
            {
                <p class="text-muted mb-0">لا توجد شعب مرتبطة.</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var c in Model.Classes)
                    {
                        <li>@c.StageNameAr / @c.GradeNameAr / @c.SectionNameAr — @c.SubjectNameAr</li>
                    }
                </ul>
            }
        </section>
    </div>
    <div class="col-lg-5">
        <section class="section-card mb-3">
            <h2>الدروس الإلكترونية</h2>
            @if (!Model.OnlineLessons.Any())
            {
                <p class="text-muted mb-0">لا توجد دروس مرتبطة.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var lesson in Model.OnlineLessons)
                    {
                        <div class="list-group-item px-0">
                            <div class="fw-semibold">@lesson.TitleAr</div>
                            <div class="small text-muted">@lesson.SubjectNameAr · @(lesson.HasVideo ? "فيديو" : "بدون فيديو") · @lesson.MaterialCount مواد</div>
                        </div>
                    }
                </div>
            }
        </section>
        <section class="section-card mb-3">
            <h2>المرفق</h2>
            @if (Model.HasAttachment)
            {
                <a class="btn btn-outline-primary" href="@Url.Action("TeacherAttachment", "Files", new { area = "", id = Model.Id })">
                    <i class="bi bi-download"></i> @(Model.AttachmentOriginalName ?? "تحميل المرفق")
                </a>
            }
            else
            {
                <p class="text-muted mb-0">لا يوجد مرفق.</p>
            }
        </section>
    </div>
</div>
