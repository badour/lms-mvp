@model SchoolLMS.Web.Models.TeacherForm
@{
    ViewData["Title"] = "إضافة معلم";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">وضع المعلم</div>
    <h1 class="h3 page-title mb-1">إضافة معلم</h1>
    <p class="text-muted mb-0">بيانات أساسية وتعليمية وربط الشعب والدروس الإلكترونية</p>
</div>

<form method="post" enctype="multipart/form-data" id="teacherForm">
    @Html.AntiForgeryToken()
    <partial name="_TeacherForm" model="Model" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ</button>
        <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
    </div>
</form>

@section Scripts {
<script>
(() => {
  const schoolSelect = document.getElementById('SchoolId');
  const sectionSelect = document.getElementById('ClassSectionIds');
  const lessonSelect = document.getElementById('OnlineLessonIds');
  const subjectSelect = document.getElementById('SubjectId');
  const yearSelect = document.getElementById('AcademicYearId');

  function fillSelect(select, items, placeholder) {
    if (!select) return;
    const selected = new Set([...select.selectedOptions].map(o => o.value));
    select.innerHTML = '';
    if (placeholder) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = placeholder;
      select.appendChild(opt);
    }
    for (const item of items) {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = item.name;
      if (selected.has(String(item.id))) opt.selected = true;
      select.appendChild(opt);
    }
  }

  async function loadLookups() {
    const schoolId = schoolSelect?.value;
    if (!schoolId) return;
    const res = await fetch('@Url.Action("Lookups")?schoolId=' + encodeURIComponent(schoolId));
    if (!res.ok) return;
    const data = await res.json();
    fillSelect(sectionSelect, data.sections || []);
    fillSelect(lessonSelect, data.lessons || []);
    fillSelect(subjectSelect, data.subjects || [], 'اختر المادة');
    fillSelect(yearSelect, data.years || [], 'السنة الحالية');
  }

  schoolSelect?.addEventListener('change', loadLookups);
})();
</script>
}
