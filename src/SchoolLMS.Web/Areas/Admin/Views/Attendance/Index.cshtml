@model IReadOnlyList<SchoolLMS.Application.DTOs.Attendance.AttendanceSessionListItemDto>
@{
    ViewData["Title"] = "حضور الصفوف";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الحضور</div>
        <h1 class="h3 page-title mb-1">حضور الصفوف</h1>
        <p class="text-muted mb-0">سجلات حضور الطلاب حسب المعلم والشعبة</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> تسجيل حضور</a>
</div>

<form method="get" class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">المدرسة</label>
            <select name="schoolId" class="form-select" asp-items="ViewBag.Schools">
                <option value="">الكل</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">تصفية</button>
        </div>
    </div>
</form>

<div class="card stat-card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>التاريخ</th>
                <th>المعلم</th>
                <th>المرحلة</th>
                <th>الشعبة</th>
                <th>حاضر</th>
                <th>غائب</th>
                <th>الحالة</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد سجلات حضور بعد.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.TeacherNameAr</td>
                    <td>@item.StageNameAr</td>
                    <td>@item.SectionNameAr</td>
                    <td><span class="pill pill-green">@item.PresentCount</span></td>
                    <td><span class="pill pill-orange">@item.AbsentCount</span></td>
                    <td>@(item.Status == SchoolLMS.Domain.Enums.PublicationStatus.Published ? "منشور" : "مسودة")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
