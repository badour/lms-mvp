@model SchoolLMS.Web.Models.AdminSendMessageForm
@{
    ViewData["Title"] = "رسالة جديدة";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">التواصل والمراسلات</div>
    <h1 class="h3 page-title mb-1">رسالة جديدة</h1>
    <p class="text-muted mb-0">أرسل رسالة إلى طالب أو حساب إدارة مدرسة مع مرفقات اختيارية</p>
</div>

<form method="post" enctype="multipart/form-data" class="section-card" id="adminMessageForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="SchoolId" class="form-label"></label>
            <select asp-for="SchoolId" class="form-select" asp-items="ViewBag.Schools" id="SchoolId">
                <option value="">اختر المدرسة</option>
            </select>
            <span asp-validation-for="SchoolId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="RecipientKind" class="form-label"></label>
            <select asp-for="RecipientKind" class="form-select" id="RecipientKind">
                <option value="@((int)SchoolLMS.Domain.Enums.StudentMessageTargetType.Student)">طالب</option>
                <option value="@((int)SchoolLMS.Domain.Enums.StudentMessageTargetType.SchoolManagement)">إدارة المدرسة</option>
            </select>
        </div>

        <div class="col-md-6" id="studentRecipientBlock">
            <label asp-for="StudentId" class="form-label"></label>
            <select asp-for="StudentId" class="form-select" id="StudentId" asp-items="ViewBag.Students">
                <option value="">اختر الطالب</option>
            </select>
            <div class="small text-muted mt-1">
                اختر المدرسة أولاً، ثم اختر الطالب من القائمة (الشكل: الرقم — الاسم، مثل عمود «الرقم» في صفحة الطلاب).
                لا تكتب الرقم يدوياً في حقل حر — يجب اختيار صف من القائمة المنسدلة.
            </div>
            <span asp-validation-for="StudentId" class="text-danger"></span>
        </div>

        <div class="col-md-6 d-none" id="managementRecipientBlock">
            <label asp-for="ManagementUserId" class="form-label"></label>
            <select asp-for="ManagementUserId" class="form-select" id="ManagementUserId" asp-items="ViewBag.ManagementAccounts">
                <option value="">اختر حساب الإدارة</option>
            </select>
            <span asp-validation-for="ManagementUserId" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Subject" class="form-label"></label>
            <input asp-for="Subject" class="form-control" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Body" class="form-label"></label>
            <textarea asp-for="Body" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Attachments" class="form-label"></label>
            <input asp-for="Attachments" class="form-control" type="file" multiple
                   accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.zip,.txt,.xls,.xlsx" />
            <div class="small text-muted mt-1">الحد الأقصى لكل مرفق 20 ميجابايت.</div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> إرسال</button>
        <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
    </div>
</form>

@section Scripts {
<script>
(() => {
  const schoolSelect = document.getElementById('SchoolId');
  const kindSelect = document.getElementById('RecipientKind');
  const studentBlock = document.getElementById('studentRecipientBlock');
  const managementBlock = document.getElementById('managementRecipientBlock');
  const studentSelect = document.getElementById('StudentId');
  const managementSelect = document.getElementById('ManagementUserId');
  const studentKind = '@((int)SchoolLMS.Domain.Enums.StudentMessageTargetType.Student)';
  const studentsUrl = '@Url.Action("SearchStudents", "Messaging", new { area = "Admin" })';
  const managementUrl = '@Url.Action("ManagementAccounts", "Messaging", new { area = "Admin" })';

  function itemId(item) { return item.id ?? item.Id; }
  function itemName(item) { return item.name ?? item.Name ?? ''; }
  function itemExtra(item) { return item.extra ?? item.Extra; }

  function fillSelect(select, items, placeholder, selectedId) {
    select.innerHTML = `<option value="">${placeholder}</option>`;
    for (const item of items || []) {
      const id = itemId(item);
      if (id == null || id === '') continue;
      const name = itemName(item);
      const extra = itemExtra(item);
      const opt = document.createElement('option');
      opt.value = String(id);
      // الرقم — الاسم (same order as Students grid)
      opt.textContent = extra ? `${extra} — ${name}` : name;
      if (selectedId && String(selectedId) === String(id)) opt.selected = true;
      select.appendChild(opt);
    }
  }

  function toggleRecipient() {
    const isStudent = kindSelect.value === studentKind;
    studentBlock.classList.toggle('d-none', !isStudent);
    managementBlock.classList.toggle('d-none', isStudent);
  }

  async function loadStudents() {
    const schoolId = schoolSelect.value;
    const selected = studentSelect.value;
    if (!schoolId) {
      fillSelect(studentSelect, [], 'اختر الطالب', null);
      return;
    }
    const res = await fetch(studentsUrl + '?schoolId=' + encodeURIComponent(schoolId) + '&term=');
    if (!res.ok) return; // keep any server-rendered options
    fillSelect(studentSelect, await res.json(), 'اختر الطالب', selected);
  }

  async function loadManagement() {
    const schoolId = schoolSelect.value;
    const selected = managementSelect.value;
    if (!schoolId) {
      fillSelect(managementSelect, [], 'اختر حساب الإدارة', null);
      return;
    }
    const res = await fetch(managementUrl + '?schoolId=' + encodeURIComponent(schoolId));
    if (!res.ok) return;
    fillSelect(managementSelect, await res.json(), 'اختر حساب الإدارة', selected);
  }

  schoolSelect.addEventListener('change', () => {
    loadStudents();
    loadManagement();
  });
  kindSelect.addEventListener('change', toggleRecipient);

  toggleRecipient();
  // Only refresh when school is already chosen (e.g. validation redisplay); do not wipe on empty school.
  if (schoolSelect.value) {
    loadStudents();
    loadManagement();
  }
})();
</script>
}
