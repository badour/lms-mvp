@model SchoolLMS.Application.Common.PagedResult<SchoolLMS.Application.DTOs.Messages.AdminMessageListItemDto>
@{
    ViewData["Title"] = "التواصل والمراسلات";
    var source = Context.Request.Query["Source"].ToString();
    var unreadOnly = string.Equals(Context.Request.Query["UnreadOnly"], "true", StringComparison.OrdinalIgnoreCase);
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">التواصل والمراسلات</div>
        <h1 class="h3 page-title mb-1">التواصل والمراسلات</h1>
        <p class="text-muted mb-0">عرض رسائل الطلاب والمعلمين وإدارة المدارس مع الرد والمرفقات</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> رسالة جديدة</a>
</div>

<form method="get" class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">بحث</label>
            <input name="Search" value="@Context.Request.Query["Search"]" class="form-control" placeholder="الموضوع / المرسل / المستلم" />
        </div>
        <div class="col-md-2">
            <label class="form-label">المدرسة</label>
            <select name="SchoolId" class="form-select" asp-items="ViewBag.Schools">
                <option value="">الكل</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">المصدر</label>
            <select name="Source" class="form-select" asp-items="ViewBag.Sources"></select>
        </div>
        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="UnreadOnly" value="true" id="UnreadOnly" @(unreadOnly ? "checked" : null) />
                <label class="form-check-label" for="UnreadOnly">غير مقروءة فقط</label>
            </div>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">تصفية</button>
        </div>
    </div>
</form>

<div class="card stat-card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>الموضوع</th>
                <th>المدرسة</th>
                <th>المرسل</th>
                <th>المستلم</th>
                <th>المصدر</th>
                <th>الحالة</th>
                <th>التاريخ</th>
                <th style="width:110px">إجراءات</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">لا توجد رسائل مطابقة.</td>
                </tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr class="@(!item.IsReadByCurrentUser ? "table-warning" : null)">
                    <td>
                        <div class="fw-semibold">@item.Subject</div>
                        <div class="small text-muted">@item.BodyPreview</div>
                        @if (item.AttachmentCount > 0 || item.ReplyCount > 0 || item.HasLegacyReply)
                        {
                            <div class="small text-muted mt-1">
                                @if (item.AttachmentCount > 0)
                                {
                                    <span class="me-2"><i class="bi bi-paperclip"></i> @item.AttachmentCount</span>
                                }
                                @if (item.ReplyCount > 0 || item.HasLegacyReply)
                                {
                                    <span><i class="bi bi-reply"></i> @(item.ReplyCount > 0 ? item.ReplyCount : 1)</span>
                                }
                            </div>
                        }
                    </td>
                    <td>@item.SchoolNameAr</td>
                    <td>@item.SenderDisplayName</td>
                    <td>@item.TargetDisplayName</td>
                    <td>@item.SourceLabelAr</td>
                    <td>
                        @if (item.IsReadByRecipient)
                        {
                            <span class="pill pill-green">مقروءة</span>
                        }
                        else
                        {
                            <span class="pill pill-orange">غير مقروءة</span>
                        }
                    </td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">عرض</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
