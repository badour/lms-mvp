@model SchoolLMS.Application.DTOs.Routines.CreateRoutineLessonRequest
@{
    ViewData["Title"] = "إضافة درس جديد";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
    <h1 class="h3 page-title mb-1">إضافة درس جديد</h1>
    <p class="text-muted mb-0">تعريف درس للمدرسة والصف مع تحديد عدد الحصص خلال السنة</p>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <section class="section-card mb-3">
        <h2>بيانات الدرس</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="SchoolId" class="form-label"></label>
                <select asp-for="SchoolId" class="form-select" asp-items="ViewBag.Schools" id="SchoolId">
                    <option value="">اختر المدرسة</option>
                </select>
                <span asp-validation-for="SchoolId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LessonName" class="form-label"></label>
                <input asp-for="LessonName" class="form-control" placeholder="مثال: الرياضيات" />
                <span asp-validation-for="LessonName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="GradeLevelId" class="form-label">اسم المرحلة</label>
                <select asp-for="GradeLevelId" class="form-select" id="GradeLevelId">
                    <option value="">اختر الصف (مثل: صف اول ابتدائي)</option>
                </select>
                <span asp-validation-for="GradeLevelId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SessionsPerYear" class="form-label"></label>
                <input asp-for="SessionsPerYear" class="form-control" type="number" min="1" max="500" />
                <span asp-validation-for="SessionsPerYear" class="text-danger"></span>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ الدرس</button>
        <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
    </div>
</form>

@section Scripts {
<script>
(() => {
  const school = document.getElementById('SchoolId');
  const grade = document.getElementById('GradeLevelId');
  const selectedGradeId = '@Model.GradeLevelId';

  function fill(select, items, placeholder, selectedId) {
    select.innerHTML = `<option value="">${placeholder}</option>`;
    for (const item of items || []) {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = item.name;
      if (selectedId && String(selectedId) === String(item.id) && selectedId !== '0') {
        opt.selected = true;
      }
      select.appendChild(opt);
    }
  }

  async function loadGrades() {
    grade.innerHTML = '<option value="">اختر الصف (مثل: صف اول ابتدائي)</option>';
    if (!school.value) return;
    const res = await fetch('@Url.Action("Grades")?schoolId=' + encodeURIComponent(school.value));
    if (res.ok) fill(grade, await res.json(), 'اختر الصف (مثل: صف اول ابتدائي)', selectedGradeId);
  }

  school.addEventListener('change', async () => {
    grade.innerHTML = '<option value="">اختر الصف (مثل: صف اول ابتدائي)</option>';
    if (!school.value) return;
    const res = await fetch('@Url.Action("Grades")?schoolId=' + encodeURIComponent(school.value));
    if (res.ok) fill(grade, await res.json(), 'اختر الصف (مثل: صف اول ابتدائي)', null);
  });

  if (school.value) {
    loadGrades();
  }
})();
</script>
}
