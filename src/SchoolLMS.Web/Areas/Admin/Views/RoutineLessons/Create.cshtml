@model SchoolLMS.Application.DTOs.Routines.CreateRoutineLessonRequest
@{
    ViewData["Title"] = "إضافة درس جديد";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
    <h1 class="h3 page-title mb-1">إضافة درس جديد</h1>
    <p class="text-muted mb-0">ربط معلم بمرحلة دراسية مع تحديد عدد الحصص خلال السنة</p>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <section class="section-card mb-3">
        <h2>بيانات الدرس</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="SchoolId" class="form-label"></label>
                <select asp-for="SchoolId" class="form-select" asp-items="ViewBag.Schools" id="SchoolId">
                    <option value="">اختر المدرسة</option>
                </select>
                <span asp-validation-for="SchoolId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TeacherId" class="form-label"></label>
                <select asp-for="TeacherId" class="form-select" id="TeacherId">
                    <option value="">اختر المعلم</option>
                </select>
                <span asp-validation-for="TeacherId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AcademicStageId" class="form-label"></label>
                <select asp-for="AcademicStageId" class="form-select" id="AcademicStageId">
                    <option value="">اختر المرحلة</option>
                </select>
                <span asp-validation-for="AcademicStageId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SessionsPerYear" class="form-label"></label>
                <input asp-for="SessionsPerYear" class="form-control" type="number" min="1" max="500" />
                <span asp-validation-for="SessionsPerYear" class="text-danger"></span>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ الدرس</button>
        <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
    </div>
</form>

@section Scripts {
<script>
(() => {
  const school = document.getElementById('SchoolId');
  const teacher = document.getElementById('TeacherId');
  const stage = document.getElementById('AcademicStageId');

  function fill(select, items, placeholder) {
    select.innerHTML = `<option value="">${placeholder}</option>`;
    for (const item of items || []) {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = item.name;
      select.appendChild(opt);
    }
  }

  async function loadLookups() {
    teacher.innerHTML = '<option value="">اختر المعلم</option>';
    stage.innerHTML = '<option value="">اختر المرحلة</option>';
    if (!school.value) return;
    const [teachersRes, stagesRes] = await Promise.all([
      fetch('@Url.Action("Teachers")?schoolId=' + encodeURIComponent(school.value)),
      fetch('@Url.Action("Stages")?schoolId=' + encodeURIComponent(school.value))
    ]);
    if (teachersRes.ok) fill(teacher, await teachersRes.json(), 'اختر المعلم');
    if (stagesRes.ok) fill(stage, await stagesRes.json(), 'اختر المرحلة');
  }

  school.addEventListener('change', loadLookups);
})();
</script>
}
