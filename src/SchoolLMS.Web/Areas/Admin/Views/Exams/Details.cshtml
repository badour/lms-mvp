@model SchoolLMS.Application.DTOs.Exams.ExamDetailsDto
@{
    ViewData["Title"] = "عرض الامتحان";
    string StatusText(SchoolLMS.Domain.Enums.PublicationStatus s) => s switch
    {
        SchoolLMS.Domain.Enums.PublicationStatus.Published => "منشور",
        SchoolLMS.Domain.Enums.PublicationStatus.Archived => "مؤرشف",
        SchoolLMS.Domain.Enums.PublicationStatus.Cancelled => "ملغى",
        _ => "مسودة"
    };
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
        <h1 class="h3 page-title mb-1">عرض الامتحان</h1>
        <p class="text-muted mb-0">@Model.SchoolNameAr · @Model.LessonNameAr</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> تعديل</a>
        <a class="btn btn-outline-primary" asp-action="Index">رجوع للقائمة</a>
    </div>
</div>

<section class="section-card">
    <h2>بيانات الامتحان</h2>
    <div class="row g-3">
        <div class="col-md-4"><div class="text-muted small">المدرسة</div><div class="fw-semibold">@Model.SchoolNameAr</div></div>
        <div class="col-md-4"><div class="text-muted small">اسم الدرس</div><div class="fw-semibold">@Model.LessonNameAr</div></div>
        <div class="col-md-4"><div class="text-muted small">المعلم</div><div class="fw-semibold">@Model.TeacherNameAr</div></div>
        <div class="col-md-4"><div class="text-muted small">المرحلة</div><div class="fw-semibold">@Model.StageNameAr</div></div>
        <div class="col-md-4"><div class="text-muted small">الشعبة</div><div class="fw-semibold">@Model.ClassNameAr</div></div>
        <div class="col-md-4"><div class="text-muted small">التاريخ والوقت</div><div class="fw-semibold">@Model.ExamDate.ToString("yyyy-MM-dd") · @Model.TimeSlot</div></div>
        <div class="col-md-4"><div class="text-muted small">الحالة</div><div class="fw-semibold">@StatusText(Model.Status)</div></div>
        <div class="col-12"><div class="text-muted small">ملاحظات</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</div></div>
        <div class="col-12"><div class="text-muted small">تعليمات الامتحان</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Instructions) ? "—" : Model.Instructions)</div></div>
    </div>
</section>
