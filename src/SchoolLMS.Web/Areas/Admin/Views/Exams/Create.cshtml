@model SchoolLMS.Web.Models.ExamCreateForm
@{
    ViewData["Title"] = "إنشاء امتحان";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الامتحانات</div>
    <h1 class="h3 page-title mb-1">إنشاء امتحان للطالب</h1>
    <p class="text-muted mb-0">اختر المعلم والمرحلة والشعبة ثم حدد التاريخ والوقت والتعليمات</p>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <section class="section-card mb-3">
        <h2>بيانات الامتحان</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="TeacherId" class="form-label"></label>
                <select asp-for="TeacherId" class="form-select" asp-items="ViewBag.Teachers" id="TeacherId">
                    <option value="">اختر المعلم</option>
                </select>
                <span asp-validation-for="TeacherId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AcademicStageId" class="form-label"></label>
                <select asp-for="AcademicStageId" class="form-select" id="AcademicStageId">
                    <option value="">اختر المرحلة</option>
                </select>
                <span asp-validation-for="AcademicStageId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ClassSectionId" class="form-label"></label>
                <select asp-for="ClassSectionId" class="form-select" id="ClassSectionId">
                    <option value="">اختر الشعبة</option>
                </select>
                <span asp-validation-for="ClassSectionId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ExamDateTime" class="form-label"></label>
                <input asp-for="ExamDateTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="ExamDateTime" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Draft)">مسودة</option>
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Published)">منشور</option>
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Archived)">مؤرشف</option>
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Cancelled)">ملغى</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="Instructions" class="form-label"></label>
                <textarea asp-for="Instructions" class="form-control" rows="4" placeholder="تعليمات الامتحان للطلاب..."></textarea>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ الامتحان</button>
        <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
    </div>
</form>

@section Scripts {
<script>
(() => {
  const teacher = document.getElementById('TeacherId');
  const stage = document.getElementById('AcademicStageId');
  const section = document.getElementById('ClassSectionId');

  function fill(select, items, placeholder) {
    select.innerHTML = `<option value="">${placeholder}</option>`;
    for (const item of items) {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = item.name;
      select.appendChild(opt);
    }
  }

  async function loadStages() {
    stage.innerHTML = '<option value="">اختر المرحلة</option>';
    section.innerHTML = '<option value="">اختر الشعبة</option>';
    if (!teacher.value) return;
    const res = await fetch('@Url.Action("Stages")?teacherId=' + encodeURIComponent(teacher.value));
    if (!res.ok) return;
    fill(stage, await res.json(), 'اختر المرحلة');
  }

  async function loadSections() {
    section.innerHTML = '<option value="">اختر الشعبة</option>';
    if (!teacher.value || !stage.value) return;
    const res = await fetch('@Url.Action("Sections")?teacherId=' + encodeURIComponent(teacher.value) + '&stageId=' + encodeURIComponent(stage.value));
    if (!res.ok) return;
    fill(section, await res.json(), 'اختر الشعبة');
  }

  teacher.addEventListener('change', loadStages);
  stage.addEventListener('change', loadSections);
})();
</script>
}
