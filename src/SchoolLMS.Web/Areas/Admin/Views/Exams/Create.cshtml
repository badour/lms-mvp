@model SchoolLMS.Web.Models.ExamCreateForm
@{
    ViewData["Title"] = "إنشاء امتحان";
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
    <h1 class="h3 page-title mb-1">إنشاء امتحان</h1>
    <p class="text-muted mb-0">يظهر الامتحان لجميع طلاب المدرسة والمرحلة واسم الصف المحددين</p>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <section class="section-card mb-3">
        <h2>بيانات الامتحان</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="SchoolId" class="form-label"></label>
                <select asp-for="SchoolId" class="form-select" asp-items="ViewBag.Schools" id="SchoolId">
                    <option value="">اختر المدرسة</option>
                </select>
                <span asp-validation-for="SchoolId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TeachingPeriodId" class="form-label"></label>
                <select asp-for="TeachingPeriodId" class="form-select" asp-items="ViewBag.Periods" id="TeachingPeriodId">
                    <option value="">اختر الفترة الزمنية</option>
                </select>
                <span asp-validation-for="TeachingPeriodId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SubjectId" class="form-label"></label>
                <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.Subjects" id="SubjectId">
                    <option value="">اختر اسم الدرس</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TeacherId" class="form-label"></label>
                <select asp-for="TeacherId" class="form-select" asp-items="ViewBag.Teachers" id="TeacherId">
                    <option value="">اختر المعلم</option>
                </select>
                <span asp-validation-for="TeacherId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="AcademicStageId" class="form-label"></label>
                <select asp-for="AcademicStageId" class="form-select" asp-items="ViewBag.Stages" id="AcademicStageId">
                    <option value="">اختر المرحلة</option>
                </select>
                <span asp-validation-for="AcademicStageId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ClassSectionId" class="form-label"></label>
                <select asp-for="ClassSectionId" class="form-select" asp-items="ViewBag.Sections" id="ClassSectionId">
                    <option value="">اختر اسم الصف</option>
                </select>
                <span asp-validation-for="ClassSectionId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ExamDate" class="form-label"></label>
                <input asp-for="ExamDate" class="form-control" type="date" />
                <span asp-validation-for="ExamDate" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Published)">منشور</option>
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Draft)">مسودة</option>
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Archived)">مؤرشف</option>
                    <option value="@((int)SchoolLMS.Domain.Enums.PublicationStatus.Cancelled)">ملغى</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="ملاحظات الامتحان"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="Instructions" class="form-label"></label>
                <textarea asp-for="Instructions" class="form-control" rows="3" placeholder="تعليمات الامتحان للطلاب (اختياري)"></textarea>
            </div>
        </div>
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ الامتحان</button>
        <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
    </div>
</form>

@section Scripts {
<script>
(() => {
  const school = document.getElementById('SchoolId');
  const period = document.getElementById('TeachingPeriodId');
  const subject = document.getElementById('SubjectId');
  const teacher = document.getElementById('TeacherId');
  const stage = document.getElementById('AcademicStageId');
  const section = document.getElementById('ClassSectionId');

  function fill(select, items, placeholder) {
    select.innerHTML = `<option value="">${placeholder}</option>`;
    for (const item of items || []) {
      const opt = document.createElement('option');
      opt.value = item.id;
      opt.textContent = item.name;
      select.appendChild(opt);
    }
  }

  async function onSchoolChanged() {
    fill(period, [], 'اختر الفترة الزمنية');
    fill(subject, [], 'اختر اسم الدرس');
    fill(teacher, [], 'اختر المعلم');
    fill(stage, [], 'اختر المرحلة');
    fill(section, [], 'اختر اسم الصف');
    if (!school.value) return;

    const [periodsRes, subjectsRes, teachersRes, stagesRes] = await Promise.all([
      fetch('@Url.Action("Periods")?schoolId=' + encodeURIComponent(school.value)),
      fetch('@Url.Action("Subjects")?schoolId=' + encodeURIComponent(school.value)),
      fetch('@Url.Action("Teachers")?schoolId=' + encodeURIComponent(school.value)),
      fetch('@Url.Action("Stages")?schoolId=' + encodeURIComponent(school.value))
    ]);

    if (periodsRes.ok) fill(period, await periodsRes.json(), 'اختر الفترة الزمنية');
    if (subjectsRes.ok) fill(subject, await subjectsRes.json(), 'اختر اسم الدرس');
    if (teachersRes.ok) fill(teacher, await teachersRes.json(), 'اختر المعلم');
    if (stagesRes.ok) fill(stage, await stagesRes.json(), 'اختر المرحلة');
  }

  async function onStageChanged() {
    fill(section, [], 'اختر اسم الصف');
    if (!school.value || !stage.value) return;
    const res = await fetch('@Url.Action("Sections")?schoolId=' + encodeURIComponent(school.value) + '&stageId=' + encodeURIComponent(stage.value));
    if (!res.ok) return;
    fill(section, await res.json(), 'اختر اسم الصف');
  }

  school.addEventListener('change', onSchoolChanged);
  stage.addEventListener('change', onStageChanged);
})();
</script>
}
