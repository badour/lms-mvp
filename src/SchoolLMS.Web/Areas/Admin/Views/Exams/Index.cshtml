@model IReadOnlyList<SchoolLMS.Application.DTOs.Exams.ExamListItemDto>
@{
    ViewData["Title"] = "الامتحانات";
    string StatusText(SchoolLMS.Domain.Enums.PublicationStatus s) => s switch
    {
        SchoolLMS.Domain.Enums.PublicationStatus.Published => "منشور",
        SchoolLMS.Domain.Enums.PublicationStatus.Archived => "مؤرشف",
        SchoolLMS.Domain.Enums.PublicationStatus.Cancelled => "ملغى",
        _ => "مسودة"
    };
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
        <h1 class="h3 page-title mb-1">الامتحانات</h1>
        <p class="text-muted mb-0">امتحانات الطلاب حسب المدرسة والشعبة</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> إنشاء امتحان</a>
</div>

<form method="get" class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">المدرسة</label>
            <select name="schoolId" class="form-select" asp-items="ViewBag.Schools">
                <option value="">الكل</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">تصفية</button>
        </div>
    </div>
</form>

<div class="card stat-card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>التاريخ</th>
                <th>الوقت</th>
                <th>المدرسة</th>
                <th>الدرس</th>
                <th>المعلم</th>
                <th>المرحلة</th>
                <th>الشعبة</th>
                <th>ملاحظات</th>
                <th>الحالة</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">لا توجد امتحانات بعد.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ExamDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.TimeSlot</td>
                    <td>@item.SchoolNameAr</td>
                    <td>@item.LessonNameAr</td>
                    <td>@item.TeacherNameAr</td>
                    <td>@item.StageNameAr</td>
                    <td>@item.ClassNameAr</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "—" : item.Notes)</td>
                    <td>@StatusText(item.Status)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
