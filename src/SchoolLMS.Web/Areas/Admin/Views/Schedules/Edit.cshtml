@model SchoolLMS.Application.DTOs.Schedules.SaveScheduleRequest
@{
    ViewData["Title"] = "تعديل الجدول";
    var schedule = ViewBag.Schedule as SchoolLMS.Application.DTOs.Schedules.ScheduleDetailsDto;
}
<div class="mb-4">
    <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
    <h1 class="h3 page-title mb-1">تعديل الجدول</h1>
    <p class="text-muted mb-0">@(schedule?.SchoolNameAr) · @(schedule?.StageNameAr) · @(schedule?.GradeNameAr) / @(schedule?.SectionNameAr)</p>
</div>

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="SchoolId" />
    <input type="hidden" asp-for="AcademicStageId" />
    <input type="hidden" asp-for="ClassSectionId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <section class="section-card mb-3">
        <h2>جدول الأسبوع (7 × 8)</h2>
        <partial name="_ScheduleGrid" model="schedule" />
    </section>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> حفظ التعديلات</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.ClassSectionId">رجوع</a>
    </div>
</form>
