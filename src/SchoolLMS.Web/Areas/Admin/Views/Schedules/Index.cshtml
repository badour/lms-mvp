@model IReadOnlyList<SchoolLMS.Application.DTOs.Schedules.ScheduleListItemDto>
@{
    ViewData["Title"] = "الجداول الدراسية";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
        <h1 class="h3 page-title mb-1">الجداول الدراسية</h1>
        <p class="text-muted mb-0">جداول الأسبوع (7 أيام × 8 حصص) حسب المدرسة والمرحلة والشعبة</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> إضافة جدول</a>
</div>

<form method="get" class="card stat-card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">المدرسة</label>
            <select name="schoolId" class="form-select" asp-items="ViewBag.Schools">
                <option value="">الكل</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100" type="submit">تصفية</button>
        </div>
    </div>
</form>

<div class="card stat-card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>المدرسة</th>
                <th>المرحلة</th>
                <th>الصف / الشعبة</th>
                <th>السنة</th>
                <th>الخانات المعبأة</th>
                <th style="width:150px">إجراءات</th>
            </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">لا توجد جداول محفوظة بعد.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SchoolNameAr</td>
                    <td>@item.StageNameAr</td>
                    <td>@item.GradeNameAr / @item.SectionNameAr</td>
                    <td>@item.YearNameAr</td>
                    <td>@item.FilledSlots</td>
                    <td>
                        <div class="d-flex gap-1 flex-wrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.ClassSectionId"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.ClassSectionId"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('حذف جدول هذه الشعبة؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.ClassSectionId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
