@model SchoolLMS.Application.DTOs.Schedules.ScheduleDetailsDto
@{
    ViewData["Title"] = "عرض الجدول";
    var dayNames = ViewBag.DayNames as string[] ?? SchoolLMS.Application.Services.Schedules.ScheduleAdminService.DayNamesAr;
    var periods = Model.Periods.Count == 8
        ? Model.Periods
        : Enumerable.Range(1, 8).Select(i => new SchoolLMS.Application.DTOs.Schedules.SchedulePeriodDto
        {
            SortOrder = i,
            NameAr = $"الحصة {i}",
            TimeSlot = ""
        }).ToList();
    var cellMap = Model.Cells
        .GroupBy(c => (c.DayOfWeek, c.PeriodSortOrder))
        .ToDictionary(g => g.Key, g => g.First());
}
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="badge-soft d-inline-block px-3 py-1 rounded-pill mb-2">الروتينات</div>
        <h1 class="h3 page-title mb-1">جدول @Model.GradeNameAr / @Model.SectionNameAr</h1>
        <p class="text-muted mb-0">@Model.SchoolNameAr · @Model.StageNameAr</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.ClassSectionId"><i class="bi bi-pencil"></i> تعديل</a>
        <a class="btn btn-outline-secondary" asp-action="Index">رجوع</a>
    </div>
</div>

<section class="section-card">
    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center schedule-grid">
            <thead>
            <tr>
                <th>اليوم</th>
                @foreach (var p in periods)
                {
                    <th>
                        <div>@p.NameAr</div>
                        @if (!string.IsNullOrWhiteSpace(p.TimeSlot))
                        {
                            <div class="small text-muted fw-normal">@p.TimeSlot</div>
                        }
                    </th>
                }
            </tr>
            </thead>
            <tbody>
            @for (byte day = 0; day < 7; day++)
            {
                <tr>
                    <th class="text-start">@dayNames[day]</th>
                    @for (var p = 1; p <= 8; p++)
                    {
                        if (cellMap.TryGetValue((day, p), out var cell))
                        {
                            <td class="text-start">
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(cell.LessonName ?? cell.EntryText) ? "—" : (cell.LessonName ?? cell.EntryText))</div>
                                <div class="small text-muted">@(string.IsNullOrWhiteSpace(cell.TeacherName) ? "—" : cell.TeacherName)</div>
                            </td>
                        }
                        else
                        {
                            <td>—</td>
                        }
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
